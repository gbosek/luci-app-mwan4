msgid "goes through %s"
msgstr "经过 %s"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/routetest.js
msgid "%s because %s"
msgstr "%s 因为 %s"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/routetest.js
msgid "stops because the path has no WAN links"
msgstr "由于路径没有 WAN 链接而停止"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/routetest.js
msgid "stops because %s are unavailable"
msgstr "由于 %s 不可用而停止"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/routetest.js
msgid "stops because %s is unavailable"
msgstr "由于 %s 不可用而停止"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/routetest.js
#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulecheck.js
msgid "uses normal routing"
msgstr "使用正常路由"

