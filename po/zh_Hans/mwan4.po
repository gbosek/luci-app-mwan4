msgstr "%s +%d"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "%s port %s"
msgstr "%s 端口 %s"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "%s from %s"
msgstr "%s 来自 %s"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "Block %s"
msgstr "块 %s"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "%s via normal routing"
msgstr "%s 通过正常路由"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "%s via %s"
msgstr "%s 通过 %s"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "%s min"
msgstr "%s 分钟"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid ""
"Notices an outage in about %s and returns to the link after %s; may switch "
"on short blips."
msgstr "注意到大约 %s 发生中断，并返回到 %s 之后的链接；可能会打开短暂的光点。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid ""
"Notices an outage in about %s and returns after %s; ignores short blips. "
"Right for most links."
msgstr "注意到大约 %s 发生中断，并在 %s 后返回；忽略短暂的光点。适用于大多数链接。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid ""
"Notices an outage in about %s and waits %s before trusting the link again; "
"best for unstable links."
msgstr "注意到大约 %s 内发生中断，并在再次信任该链接之前等待 %s；最适合不稳定的链接。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "Sensitive"
msgstr "敏感的"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "Balanced"
msgstr "均衡"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
