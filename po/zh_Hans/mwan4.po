msgstr "使用不存在的路径“%s”"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/routetest.js
msgid "uses normal routing because no WAN link in the path is available"
msgstr "使用正常路由，因为路径中没有可用的 WAN 链路"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/routetest.js
