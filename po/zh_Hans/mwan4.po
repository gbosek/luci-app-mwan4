msgstr "%s 和 %d 更多"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/routetest.js
msgid "Assumes the site does not resolve into the address ranges of: %s."
msgstr "假设站点未解析为以下地址范围：%s。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/routetest.js
msgid "Matches rule \"%s\" (#%d) and %s."
msgstr "匹配规则“%s”(#%d) 和 %s。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/routetest.js
msgid "Cannot tell: rule \"%s\" (#%d) %s."
msgstr "无法分辨：规则“%s”(#%d) %s。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/routetest.js
msgid "No routing rule matches, so this traffic uses normal routing."
msgstr "没有路由规则匹配，因此此流量使用正常路由。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/routetest.js
msgid "Most likely: %s Rule \"%s\" (#%d) could change this because it %s."
msgstr "最有可能的是：%s 规则“%s”(#%d) 可能会改变这一点，因为它是 %s。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulecheck.js
msgid ""
"The rule \"%s\" above already matches all of this traffic, so this rule is "
"never used. Move this rule above it or narrow \"%s\"."
msgstr "上面的规则“%s”已经匹配所有此流量，因此永远不会使用此规则。将此规则移至其上方或缩小“%s”。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulecheck.js
msgid ""
"The rule \"%s\" below matches the same traffic with another path, so it is "
"never used. Delete one of the two rules or narrow one of them."
msgstr "下面的规则“%s”将相同的流量与另一条路径匹配，因此从未使用过。删除两条规则之一或缩小其中一条规则。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulecheck.js
msgid "The path \"%s\" does not exist. Choose another path for this rule."
msgstr "路径“%s”不存在。为此规则选择另一条路径。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulecheck.js
msgid ""
"The path \"%s\" has no enabled WAN links. Enable a WAN link in it or choose "
"another path."
msgstr "路径“%s”没有启用的 WAN 链接。启用其中的 WAN 链接或选择其他路径。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulecheck.js
msgid "stops"
msgstr "停止"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulecheck.js
msgid ""
"All WAN links of the path \"%s\" (%s) are unavailable right now, so this "
"rule %s. Bring a link back up or choose another path."
msgstr "路径“%s”(%s) 的所有 WAN 链路目前均不可用，因此此规则为 %s。恢复链接或选择其他路径。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulecheck.js
msgid ""
"This rule blocks matching traffic: nothing is sent through any WAN link. "
"Choose a WAN link path if it should still get out."
msgstr "此规则会阻止匹配的流量：不会通过任何 WAN 链接发送任何内容。如果 WAN 链接路径仍应出去，请选择该路径。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulecheck.js
msgid ""
"Devices that use their own DNS server or encrypted DNS are not matched by "
"site names. Make the router the only DNS server for the LAN, or match by "
"address instead."
msgstr "使用自己的 DNS 服务器或加密 DNS 的设备与站点名称不匹配。让路由器成为 LAN 的唯一 DNS 服务器，或者改为按地址匹配。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulecheck.js
msgid ""
"This rule sends all traffic from all devices through \"%s\", so the rules "
"below it are never used: %s. Narrow it to a site or device, or move it to "
"the end."
msgstr "此规则通过“%s”发送来自所有设备的所有流量，因此永远不会使用其下面的规则：%s。将其缩小到某个站点或设备，或将其移至末尾。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulecheck.js
msgid ""
"This rule sends all traffic from all devices through \"%s\". Narrow it to a "
"site or device unless that is intended."
msgstr "此规则通过“%s”发送来自所有设备的所有流量。除非有意为之，否则将其范围缩小到某个站点或设备。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulesui.js
msgid "Choose a network."
msgstr "选择一个网络。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulesui.js
msgid "Use a positive number of seconds."
msgstr "使用正数秒。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulesui.js
msgid "Enter a site or address, for example youtube.com."
msgstr "输入网站或地址，例如 youtube.com。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulesui.js
msgid "Enter at least one port, for example 3074 or 27015-27030."
msgstr "至少输入一个端口，例如 3074 或 27015-27030。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulesui.js
msgid "Choose a WAN link."
msgstr "选择 WAN 链接。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulesui.js
msgid "Copy of %s"
msgstr "%s 的副本"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulesui.js
msgid "Existing paths"
msgstr "现有路径"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulesui.js
msgid "Enter a site such as youtube.com or an IP address."
msgstr "输入站点，例如 youtube.com 或 IP 地址。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulesui.js
msgid "Use an IP address or a MAC address."
msgstr "使用 IP 地址或 MAC 地址。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulesui.js
msgid "Use one port from 1 to 65535."
msgstr "使用 1 到 65535 之间的一个端口。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulesui.js
msgid "Matches"
msgstr "火柴"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulesui.js
msgid "Cannot tell: %s"
msgstr "无法分辨：%s"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulesui.js
msgid "Skipped: %s"
msgstr "跳过：%s"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/rulesui.js
msgid "Assumed not to apply, because they only match IP addresses: %s."
msgstr "假设不适用，因为它们只匹配IP地址：%s。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "Site or service"
msgstr "网站或服务"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "youtube.com"
msgstr "youtube.com"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid ""
"A domain such as youtube.com also covers its subdomains. IP addresses and "
"networks work too."
msgstr "youtube.com 等域也涵盖其子域。 IP 地址和网络也可以工作。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
#: luci-app-mwan4/htdocs/luci-static/resources/view/mwan4/network/advanced.js
#: luci-app-mwan4/htdocs/luci-static/resources/view/mwan4/status/diagnostics.js
msgid "Device"
msgstr "设备"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "192.168.1.20"
msgstr "192.168.1.20"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid ""
"The IP address or MAC address of the device. Leave empty for every device."
msgstr "设备的 IP 地址或 MAC 地址。将每个设备留空。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "The internet connection or tunnel to use."
msgstr "要使用的互联网连接或隧道。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "Ports"
msgstr "港口"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "3074, 27015-27030"
msgstr "3074, 27015-27030"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "Ports or ranges separated by commas, for example 3074 or 27015-27030."
msgstr "以逗号分隔的端口或范围，例如 3074 或 27015-27030。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "Send a site through one link"
msgstr "通过一个链接发送网站"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid ""
"The site uses this link first and switches to another one only if it is "
"unavailable."
msgstr "该站点首先使用此链接，仅在该链接不可用时才切换到另一个链接。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "Keep a site on one link only (never leak)"
msgstr "仅将网站保留在一个链接上（绝不泄漏）"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid ""
"The site only ever uses this link; if the link is unavailable the traffic "
"stops instead of leaking elsewhere."
msgstr "该网站仅使用此链接；如果链接不可用，流量就会停止，而不是泄漏到其他地方。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "Make a device use a link"
msgstr "让设备使用链接"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid ""
"Everything from this device uses this link first and switches to another one"
" only if it is unavailable."
msgstr "该设备上的所有内容都会首先使用此链接，只有在该链接不可用时才会切换到另一个链接。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "Keep a device on a VPN or tunnel"
msgstr "将设备保留在 VPN 或隧道上"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid ""
"Everything from this device only uses this VPN or tunnel; if it is down the "
"traffic stops instead of leaking."
msgstr "此设备上的所有内容仅使用此 VPN 或隧道；如果它关闭了，交通就会停止而不是泄漏。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "VPN or tunnel"
msgstr "VPN 或隧道"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "Block a site"
msgstr "阻止网站"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "Traffic to the site is dropped, whatever link is up."
msgstr "无论链接如何，该网站的流量都会下降。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "Site to block"
msgstr "要阻止的网站"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid "Speed up a game or call"
msgstr "加快游戏或通话速度"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
msgid ""
"Game and call traffic on these UDP ports uses the best link you pick first."
msgstr "这些 UDP 端口上的游戏和通话流量使用您首先选择的最佳链接。"

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/templates.js
