#!/bin/sh

# The paired backend's 90-mwan4 owns the complete type/option migration.
# Do not rename policy/member first and strand their legacy properties.

[ -x /etc/init.d/rpcd ] && /etc/init.d/rpcd restart || true
[ -x /etc/init.d/uhttpd ] && /etc/init.d/uhttpd restart || true
[ ! -x /etc/init.d/mwan4 ] || ! /etc/init.d/mwan4 running || /etc/init.d/mwan4 reload

exit 0
